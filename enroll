<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="robots" content="noindex,nofollow"><title>Sign up - NextUp Credit Pro</title><link rel="icon" href="../icons/logo.svg"><meta name="theme-color" content="#1F4FD8">
<style>
*{box-sizing:border-box}body{margin:0;font:16px/1.5 system-ui,-apple-system,sans-serif;background:#F5F7FB;color:#111C2B;min-height:100vh;padding:20px}
#wrap{max-width:560px;margin:0 auto}
.head{text-align:center;margin:10px 0 22px}.head img{width:48px;height:48px}
h1{font-size:22px;margin:10px 0 4px}p.sub{color:#5a6678;margin:0}
#card{background:#fff;border-radius:16px;padding:24px;box-shadow:0 6px 30px #1f4fd81a}
#cd-marketing-message-widget{margin-bottom:14px;font-size:13px;color:#5a6678}
#cd-cobrand-widget:empty{display:none}
#cd-progress-widget{margin-bottom:18px}#cd-memberplans-widget{margin-bottom:18px}
.err{display:none;background:#fdecea;color:#b42318;border-radius:10px;padding:14px;font-size:14px;margin-bottom:16px}
.err button{display:block;margin-top:10px;background:#b42318;color:#fff;border:0;border-radius:8px;padding:9px 14px;font-weight:600;cursor:pointer}
.note{font-size:13px;color:#8a94a6;text-align:center;margin-top:18px}
/* Nudge the widget's own theme toward NextUp's brand blue. Full variable list: ConsumerDirect docs, "Customizing Look And Feel". */
#cd-signup-widget{
  --cd-primary-btn-bg:#1F4FD8;
  --cd-primary-btn-hover:#173ea8;
  --cd-link-color:#1F4FD8;
  --cd-progress-bg-active:#1F4FD8;
  --cd-progress-bg-completed:#1F4FD8;
  --cd-border-radius:10px;
  --cd-font-family:system-ui,-apple-system,sans-serif;
}
</style></head>
<body><div id="wrap">
<div class="head"><img src="../icons/logo.svg" alt=""><h1>Get started</h1><p class="sub">Sign up for credit monitoring to begin your dispute process.</p></div>
<div id="err" class="err"><span id="errtext"></span><button id="retry" type="button">Start over</button></div>
<div id="card">
  <div id="cd-marketing-message-widget"></div>
  <div id="cd-cobrand-widget"></div>
  <div id="cd-progress-widget"></div>
  <div id="cd-memberplans-widget"></div>
  <input type="hidden" name="PID" id="cd-pid-field" value="" />
  <div id="cd-signup-widget" data-switcher></div>
</div>
<p class="note">Private beta build (stage environment). Powered by ConsumerDirect / SmartCredit.</p>
</div>

<script src="../config.js"></script>
<script>
(function () {
  var cfg = window.NCP || {};
  var isProd = cfg.CD_ENV === 'production';
  var clientKey = isProd ? cfg.CD_PROD_CLIENT_KEY : cfg.CD_STAGE_CLIENT_KEY;
  var memberUrl = isProd ? cfg.CD_PROD_MEMBER_URL : cfg.CD_STAGE_MEMBER_URL;
  var cdnSrc = isProd ? cfg.CD_PROD_CDN : cfg.CD_STAGE_CDN;
  var productName = cfg.CD_PRODUCT_NAME || 'smartcredit';
  var pid = cfg.CD_PID || '';

  function showErr(msg) {
    document.getElementById('errtext').textContent = msg;
    document.getElementById('err').style.display = 'block';
  }

  var placeholder = /^PASTE_/;
  if (!clientKey || placeholder.test(clientKey) || !memberUrl || placeholder.test(memberUrl) || !cdnSrc || placeholder.test(cdnSrc)) {
    showErr('Signup is not configured yet (missing ' + (isProd ? 'production' : 'stage') + ' ConsumerDirect settings in config.js).');
    document.getElementById('retry').style.display = 'none';
    return;
  }

  document.getElementById('cd-pid-field').value = pid;
  document.getElementById('cd-marketing-message-widget').setAttribute('data-companyname', cfg.CD_COMPANY_NAME || 'NextUp Credit Pro');

  var widget = document.getElementById('cd-signup-widget');
  widget.setAttribute('data-clientkey', clientKey);
  widget.setAttribute('data-productname', productName);
  widget.setAttribute('data-memberurl', memberUrl);

  var s = document.createElement('script');
  s.type = 'module';
  s.async = true;
  s.defer = true;
  s.src = cdnSrc;
  s.onerror = function () { showErr('Could not load the signup widget. Please refresh, or contact support@nextupcapitalgroup.com.'); };
  document.body.appendChild(s);

  /* Optional but recommended by ConsumerDirect: stronger password validation on the widget's
     account-creation step. Loaded after the widget script per their docs. */
  var zx = document.createElement('script');
  zx.async = true; zx.defer = true;
  zx.src = 'https://www.unpkg.com/zxcvbn@4.4.2/dist/zxcvbn.js';
  document.body.appendChild(zx);

  document.getElementById('retry').addEventListener('click', function () {
    document.getElementById('err').style.display = 'none';
    if (window.CDWidgets && window.CDWidgets.restartSignup) window.CDWidgets.restartSignup();
  });

  var ERROR_STEPS = { SignupError: 1, SignupErrorOutsideUS: 1, SignupErrorBlackbox: 1 };
  var ERROR_MSG = {
    SignupError: 'Something went wrong during signup. You can try again below.',
    SignupErrorOutsideUS: 'We could not verify an identity at a US address. You can try again below, or contact your agent.',
    SignupErrorBlackbox: 'We could not complete this signup. You can try again below, or contact your agent.'
  };

  /* Log every step ConsumerDirect reports so we can see the real flow in the stage sandbox, and so
     an agent can eventually follow up on an enrollment that stalled partway through. Insert-only,
     anon-safe table - see supabase/cd_signups.sql. ConfirmationStep = the widget's own "Welcome to
     your membership!" screen, i.e. a completed signup. */
  document.addEventListener('cd-signup-next-step', function (cdEvent) {
    var d = cdEvent.detail || {};
    console.log('cd-signup-next-step', d);

    if (ERROR_STEPS[d.step]) {
      showErr(ERROR_MSG[d.step] || 'Something went wrong during signup. You can try again below.');
    } else {
      document.getElementById('err').style.display = 'none';
    }

    if (!cfg.SUPABASE_URL || !cfg.SUPABASE_ANON_KEY) return;
    fetch(cfg.SUPABASE_URL + '/rest/v1/cd_signups', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'apikey': cfg.SUPABASE_ANON_KEY,
        'Authorization': 'Bearer ' + cfg.SUPABASE_ANON_KEY,
        'Prefer': 'return=minimal'
      },
      body: JSON.stringify({
        pid: d.PID || pid,
        step: d.step || null,
        customer_token: d.customerToken || null,
        customer_name: d.customerName || null,
        customer_email: d.customerEmail || null,
        company: d.company || null,
        member_plan: d.memberPlan || null,
        env: cfg.CD_ENV
      })
    }).catch(function () { /* best-effort logging only, never block the signup flow */ });
  });
})();
</script>
</body></html>
